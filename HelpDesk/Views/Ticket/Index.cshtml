@model IEnumerable<HelpDesk.ViewModels.TicketListViewModel>
@{
    ViewData["Title"] = "Mes tickets";
}

<div class="container py-4">

    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Mes tickets</h2>
            <small class="text-muted">Suivi de toutes vos demandes de support</small>
        </div>
        <a asp-controller="Ticket" asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Nouveau ticket
        </a>
    </div>

    <!-- Filtres -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-2">
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Index" class="btn btn-sm btn-primary">Tous</a>
                <a asp-action="Index" asp-route-status="Ouvert"
                   class="btn btn-sm btn-outline-danger">🔴 Ouverts</a>
                <a asp-action="Index" asp-route-status="EnCours"
                   class="btn btn-sm btn-outline-warning">🟠 En cours</a>
                <a asp-action="Index" asp-route-status="Resolu"
                   class="btn btn-sm btn-outline-success">🟢 Résolus</a>
            </div>
        </div>
    </div>

    <!-- Tableau -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="text-muted mt-3">Aucun ticket trouvé.</p>
            <a asp-action="Create" class="btn btn-primary mt-2">
                Créer votre premier ticket
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Titre</th>
                            <th>Catégorie</th>
                            <th>Priorité</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th>Assigné à</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td class="text-muted small">#@ticket.Id</td>
                                <td class="fw-semibold">@ticket.Title</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(ticket.Category.HasValue
                                                                        ? ticket.Category.Value.ToString()
                                                                        : "Non classé")
                            </span>
                        </td>
                        <td>
                            @switch (ticket.Priority)
                                    {
                                        case HelpDesk.Models.PrioriteTicket.Haute:
                                            <span class="badge bg-danger">🔴 Haute</span>
                                            break;
                                        case HelpDesk.Models.PrioriteTicket.Moyenne:
                                            <span class="badge bg-warning text-dark">🟠 Moyenne</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">🟢 Basse</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (ticket.Status)
                                    {
                                        case HelpDesk.Models.StatutTicket.Ouvert:
                                            <span class="badge bg-danger">Ouvert</span>
                                            break;
                                        case HelpDesk.Models.StatutTicket.EnCours:
                                            <span class="badge bg-warning text-dark">En cours</span>
                                            break;
                                        case HelpDesk.Models.StatutTicket.Resolu:
                                            <span class="badge bg-success">Résolu</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@ticket.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted small">
                                    @ticket.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-muted small">
                                    @(ticket.AssignedToName ?? "Non assigné")
                                </td>
                                <td>
                                    <a asp-action="Detail" asp-route-id="@ticket.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Voir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>