@model IEnumerable<HelpDesk.ViewModels.TicketListViewModel>

@{
    ViewData["Title"] = "Mes tickets";
    var currentStatus = Context.Request.Query["status"].ToString();

    var allClass     = string.IsNullOrEmpty(currentStatus) ? "active" : "";
    var ouvertClass  = currentStatus == "Ouvert"  ? "active" : "";
    var enCoursClass = currentStatus == "EnCours" ? "active" : "";
    var resoluClass  = currentStatus == "Resolu"  ? "active" : "";

    // On déclare les listes ici pour éviter les problèmes de contexte Razor
    var actifs  = Model.Where(t => t.Status != StatutTicket.Resolu).ToList();
    var resolus = Model.Where(t => t.Status == StatutTicket.Resolu).ToList();
}

<div class="d-flex" style="min-height: calc(100vh - 60px);">

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-section">NAVIGATION</div>
        <a asp-controller="Ticket" asp-action="Index" class="sidebar-link">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Ticket" asp-action="Create" class="sidebar-link">
            <i class="bi bi-plus-circle"></i> Nouveau ticket
        </a>
        <a asp-controller="Ticket" asp-action="Index" class="sidebar-link active">
            <i class="bi bi-ticket-detailed"></i> Mes tickets
            <span class="badge bg-danger ms-auto">@Model.Count()</span>
        </a>
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">KB</div>
                <div>
                    <div class="user-name">Utilisateur</div>
                    <div class="user-email">user@@helpdesk.ma</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Zone principale -->
    <div class="main-area">
        <div class="top-bar">
            <span class="page-title">Mes tickets</span>
            <div class="d-flex gap-2">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Rechercher..."
                           id="searchInput" onkeyup="filterTable()" />
                </div>
                <a asp-controller="Ticket" asp-action="Create" class="btn-create">
                    + Nouveau
                </a>
            </div>
        </div>

        <div class="content-area">

            <!-- Filtres -->
            <div class="d-flex gap-2 mb-4">
                <a asp-action="Index" class="filter-btn @allClass">
                    Tous <span class="badge bg-secondary ms-1">@Model.Count()</span>
                </a>
                <a asp-action="Index" asp-route-status="Ouvert"
                   class="filter-btn @ouvertClass">
                    Ouverts
                    <span class="badge bg-danger ms-1">
                        @Model.Count(t => t.Status == StatutTicket.Ouvert)
                    </span>
                </a>
                <a asp-action="Index" asp-route-status="EnCours"
                   class="filter-btn @enCoursClass">
                    En cours
                    <span class="badge bg-warning text-dark ms-1">
                        @Model.Count(t => t.Status == StatutTicket.EnCours)
                    </span>
                </a>
                <a asp-action="Index" asp-route-status="Resolu"
                   class="filter-btn @resoluClass">
                    Résolus
                    <span class="badge bg-success ms-1">
                        @Model.Count(t => t.Status == StatutTicket.Resolu)
                    </span>
                </a>
            </div>

            <!-- État vide -->
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <p class="text-muted mt-3">Aucun ticket trouvé.</p>
                    <a asp-action="Create" class="btn btn-primary mt-2">
                        Créer votre premier ticket
                    </a>
                </div>
            }

            <!-- Section : tickets actifs -->
            @if (actifs.Any())
            {
                <div class="section-label">EN ATTENTE DE RÉSOLUTION</div>
                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var t in actifs)
                    {
                        <div class="ticket-card @(t.Priority == PrioriteTicket.Haute ? "ticket-urgent" : "")">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-fill">
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        <span class="text-muted small">#@t.Id</span>
                                        <span class="fw-semibold">@t.Title</span>
                                        @if (t.Status == StatutTicket.EnCours)
                                        {
                                            <span class="badge-status status-encours">En cours</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status status-ouvert">Ouvert</span>
                                        }
                                        @if (t.Priority == PrioriteTicket.Haute)
                                        {
                                            <span class="badge-priority priority-haute">Haute</span>
                                        }
                                        else if (t.Priority == PrioriteTicket.Moyenne)
                                        {
                                            <span class="badge-priority priority-moyenne">Moyenne</span>
                                        }
                                        else
                                        {
                                            <span class="badge-priority priority-basse">Basse</span>
                                        }
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-tag me-1"></i>@t.Category.ToString()
                                        <span class="mx-2">·</span>
                                        <i class="bi bi-person me-1"></i>
                                        @(t.AssignedToName != null ? $"Technicien {t.AssignedToName}" : "Non assigné")
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3 ms-3">
                                    <span class="text-muted small">@t.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    <a asp-action="Detail" asp-route-id="@t.Id" class="btn-voir">Voir →</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Section : tickets résolus -->
            @if (resolus.Any())
            {
                <div class="section-label">RÉSOLUS</div>
                <div class="d-flex flex-column gap-3">
                    @foreach (var t in resolus)
                    {
                        <div class="ticket-card ticket-resolu">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-fill">
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        <span class="text-muted small">#@t.Id</span>
                                        <span class="fw-semibold text-muted">@t.Title</span>
                                        <span class="badge-status status-resolu">Résolu</span>
                                        @if (t.Priority == PrioriteTicket.Haute)
                                        {
                                            <span class="badge-priority priority-haute">Haute</span>
                                        }
                                        else if (t.Priority == PrioriteTicket.Moyenne)
                                        {
                                            <span class="badge-priority priority-moyenne">Moyenne</span>
                                        }
                                        else
                                        {
                                            <span class="badge-priority priority-basse">Basse</span>
                                        }
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-tag me-1"></i>@t.Category.ToString()
                                        <span class="mx-2">·</span>
                                        ✓ Résolu en 1j
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3 ms-3">
                                    <span class="text-muted small">@t.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    <a asp-action="Detail" asp-route-id="@t.Id" class="btn-voir">Voir →</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>

<style>
    .sidebar {
        width: 200px;
        min-height: calc(100vh - 60px);
        background: #1F4E79;
        color: white;
        display: flex;
        flex-direction: column;
        padding: 16px 0;
        flex-shrink: 0;
        position: sticky;
        top: 60px;
        height: calc(100vh - 60px);
    }

    .sidebar-section {
        font-size: 0.65rem;
        color: rgba(255,255,255,0.45);
        letter-spacing: 1px;
        padding: 16px 20px 6px;
    }

    .sidebar-link {
        display: flex; align-items: center; gap: 10px;
        padding: 9px 20px;
        color: rgba(255,255,255,0.75);
        text-decoration: none; font-size: 0.88rem;
    }

    .sidebar-link:hover, .sidebar-link.active {
        background: rgba(255,255,255,0.12);
        color: white;
    }

    .sidebar-footer {
        margin-top: auto;
        padding: 16px 20px;
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    .user-info { display: flex; align-items: center; gap: 10px; }

    .user-avatar {
        width: 32px; height: 32px; border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; font-weight: 600;
    }

    .user-name  { font-size: 0.82rem; color: white; }
    .user-email { font-size: 0.72rem; color: rgba(255,255,255,0.55); }

    .main-area { flex: 1; display: flex; flex-direction: column; }

    .top-bar {
        background: white; border-bottom: 1px solid #e5e7eb;
        padding: 12px 24px;
        display: flex; justify-content: space-between; align-items: center;
    }

    .page-title { font-size: 1rem; font-weight: 600; color: #1a1a2e; }

    .search-box {
        display: flex; align-items: center; gap: 8px;
        background: #f4f6fa; border: 1px solid #e5e7eb;
        border-radius: 8px; padding: 6px 12px;
    }

    .search-box input {
        border: none; background: none; outline: none;
        font-size: 0.85rem; width: 180px;
    }

    .btn-create {
        background: #1F4E79; color: white; border: none;
        padding: 7px 16px; border-radius: 8px;
        font-size: 0.85rem; text-decoration: none; white-space: nowrap;
    }

    .btn-create:hover { background: #163a5e; color: white; }

    .content-area { padding: 24px; flex: 1; overflow-y: auto; }

    .filter-btn {
        background: white; border: 1px solid #e5e7eb;
        border-radius: 8px; padding: 6px 14px;
        font-size: 0.82rem; text-decoration: none; color: #374151;
    }

    .filter-btn.active {
        background: #1F4E79; color: white; border-color: #1F4E79;
    }

    .section-label {
        font-size: 0.68rem; font-weight: 600;
        letter-spacing: 1px; color: #9ca3af;
        margin-bottom: 12px;
    }

    .ticket-card {
        background: white; border-radius: 10px;
        padding: 16px 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        border-left: 3px solid transparent;
    }

    .ticket-urgent { border-left-color: #ef4444; }
    .ticket-resolu { opacity: 0.75; }

    .badge-status {
        padding: 3px 10px; border-radius: 20px;
        font-size: 0.72rem; font-weight: 500;
    }

    .status-encours { background: #FEF3C7; color: #92400E; }
    .status-ouvert  { background: #FEE2E2; color: #991B1B; }
    .status-resolu  { background: #D1FAE5; color: #065F46; }

    .badge-priority { padding: 2px 8px; border-radius: 20px; font-size: 0.72rem; }

    .priority-haute  { background: #FEE2E2; color: #991B1B; }
    .priority-moyenne{ background: #FEF3C7; color: #92400E; }
    .priority-basse  { background: #F3F4F6; color: #6B7280; }

    .btn-voir {
        border: 1px solid #d1d5db; background: white; color: #374151;
        border-radius: 6px; padding: 4px 12px;
        font-size: 0.82rem; text-decoration: none; white-space: nowrap;
    }

    .btn-voir:hover { background: #f4f6fa; color: #1F4E79; }
</style>

@section Scripts {
    <script>
        function filterTable() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('.ticket-card').forEach(card => {
                card.style.display =
                    card.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
}
