@model IEnumerable<HelpDesk.ViewModels.TicketListViewModel>
@{
    ViewData["Title"] = "Mes tickets";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Mes tickets</h2>
            <small class="text-muted">Suivi de toutes vos demandes de support</small>
        </div>
        <a asp-controller="Ticket" asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Nouveau ticket
        </a>
    </div>

    <!-- Filtres -->
    <div class="d-flex gap-2 flex-wrap">
        @{
            var currentStatus = Context.Request.Query["status"].ToString();
        }
        <a asp-action="Index"
           class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-outline-secondary")">
            Tous
        </a>
        <a asp-action="Index" asp-route-status="Ouvert"
           class="btn btn-sm @(currentStatus == "Ouvert" ? "btn-danger text-white" : "btn-outline-danger")">
            🔴 Ouverts
        </a>
        <a asp-action="Index" asp-route-status="EnCours"
           class="btn btn-sm @(currentStatus == "EnCours" ? "btn-warning text-dark" : "btn-outline-warning")">
            🟠 En cours
        </a>
        <a asp-action="Index" asp-route-status="Resolu"
           class="btn btn-sm @(currentStatus == "Resolu" ? "btn-success text-white" : "btn-outline-success")">
            🟢 Résolus
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="text-muted mt-3">Aucun ticket trouvé.</p>
            <a asp-action="Create" class="btn btn-primary mt-2">
                Créer votre premier ticket
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Titre</th>
                            <th>Catégorie</th>
                            <th>Priorité</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th>Assigné à</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="text-muted small">#@t.Id</td>
                                <td class="fw-semibold">@t.Title</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @t.Category.ToString()
                                    </span>
                                </td>
                                <td>
                                    @if (t.Priority == HelpDesk.Models.PrioriteTicket.Haute)
                                    {
                                        <span class="badge bg-danger">🔴 Haute</span>
                                    }
                                    else if (t.Priority == HelpDesk.Models.PrioriteTicket.Moyenne)
                                    {
                                        <span class="badge bg-warning text-dark">🟠 Moyenne</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">🟢 Basse</span>
                                    }
                                </td>
                                <td>
                                    @if (t.Status == HelpDesk.Models.StatutTicket.Ouvert)
                                    {
                                        <span class="badge bg-danger">Ouvert</span>
                                    }
                                    else if (t.Status == HelpDesk.Models.StatutTicket.EnCours)
                                    {
                                        <span class="badge bg-warning text-dark">En cours</span>
                                    }
                                    else if (t.Status == HelpDesk.Models.StatutTicket.Resolu)
                                    {
                                        <span class="badge bg-success">Résolu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@t.Status</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @t.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-muted small">
                                    @(t.AssignedToName ?? "Non assigné")
                                </td>
                                <td>
                                    <a asp-action="Detail" asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-primary">Voir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>