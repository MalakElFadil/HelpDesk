@model HelpDesk.ViewModels.TicketDetailViewModel
@{
    ViewData["Title"] = "Ticket #" + Model.Id;
}

<div class="d-flex" style="min-height: calc(100vh - 60px);">

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-section">NAVIGATION</div>
        <a asp-controller="Ticket" asp-action="Index" class="sidebar-link">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Ticket" asp-action="Create" class="sidebar-link">
            <i class="bi bi-plus-circle"></i> Nouveau ticket
        </a>
        <a asp-controller="Ticket" asp-action="Index"
           class="sidebar-link active">
            <i class="bi bi-ticket-detailed"></i> Mes tickets
        </a>
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">KB</div>
                <div>
                    <div class="user-name">Utilisateur</div>
                    <div class="user-email">user@@helpdesk.ma</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenu -->
    <div class="main-area">
        <div class="top-bar">
            <div>
                <a asp-action="Index"
                   class="text-muted small text-decoration-none">
                    ← Mes tickets
                </a>
                <span class="text-muted small mx-2">/</span>
                <span class="small fw-semibold">Ticket #@Model.Id</span>
            </div>
        </div>

        <div class="content-area">
            <div class="row g-4">

                <!-- Colonne principale -->
                <div class="col-lg-8">

                    <!-- Header ticket -->
                    <div class="ticket-header mb-4">
                        <span class="text-muted small">#@Model.Id</span>
                        <h3 class="fw-bold mb-2">@Model.Title</h3>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (Model.Status == HelpDesk.Models.StatutTicket.EnCours)
                            {
                                <span class="badge-status status-encours">En cours</span>
                            }
                            else if (Model.Status == HelpDesk.Models.StatutTicket.Ouvert)
                            {
                                <span class="badge-status status-ouvert">Ouvert</span>
                            }
                            else
                            {
                                <span class="badge-status status-resolu">Résolu</span>
                            }
                            @if (Model.Priority == HelpDesk.Models.PrioriteTicket.Haute)
                            {
                                <span class="badge-priority priority-haute">Haute priorité</span>
                            }
                            <span class="badge bg-light text-dark border small">
                                <i class="bi bi-tag me-1"></i>@Model.Category.ToString()
                            </span>
                            <span class="text-muted small">
                                📅 @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                — 🔧 Assigné à :
                                @(Model.AssignedToName ?? "Non assigné")
                            </span>
                        </div>
                    </div>

                    <!-- Bloc IA -->
                    @if (!string.IsNullOrEmpty(Model.AIAnalysis))
                    {
                        <div class="ia-block mb-4">
                            <div class="ia-header">
                                <span>✦ Analyse IA automatique</span>
                                <a href="#" class="small text-muted">Groq / Llama</a>
                            </div>
                            <div class="ia-body">
                                <p class="mb-0 small" style="white-space:pre-wrap;">
                                    @Model.AIAnalysis
                                </p>
                            </div>
                        </div>
                    }

                    <!-- Description -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="mb-0 fw-semibold">Description du problème</h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-0" style="white-space:pre-wrap;">
                                @Model.Description
                            </p>
                        </div>
                    </div>

                    <!-- Fil de discussion -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom py-3
                                    d-flex justify-content-between">
                            <h6 class="mb-0 fw-semibold">Fil de discussion</h6>
                            <span class="badge bg-secondary">
                                @Model.Comments.Count messages
                            </span>
                        </div>
                        <div class="card-body p-0">
                            @if (!Model.Comments.Any())
                            {
                                <div class="text-center py-4 text-muted">
                                    <p class="mb-0 small">Aucun message pour l'instant.</p>
                                </div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var c in Model.Comments)
                                    {
                                        <li class="list-group-item px-4 py-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="avatar-circle"
                                                         style="background:@(c.IsCurrentUser ? "#1F4E79" : "#6c757d")">
                                                        @c.AuthorName.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <span class="fw-semibold small">
                                                        @c.AuthorName
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(c.AuthorRole))
                                                    {
                                                        <span class="badge @(c.AuthorRole == "Technicien" ? "bg-info text-dark" : "bg-secondary") small">
                                                            @c.AuthorRole
                                                        </span>
                                                    }
                                                </div>
                                                <small class="text-muted">
                                                    @c.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                            </div>
                                            <p class="mb-0 ms-5 small">@c.Content</p>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    <!-- Zone commentaire -->
                    @if (Model.Status != HelpDesk.Models.StatutTicket.Resolu)
                    {
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-3">
                                <form asp-action="AddComment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId"
                                           value="@Model.Id" />
                                    <div class="d-flex gap-3 align-items-start">
                                        <div class="avatar-circle"
                                             style="background:#1F4E79;flex-shrink:0;">
                                            KB
                                        </div>
                                        <div class="flex-fill">
                                            <textarea name="content"
                                                  class="form-control border-0 bg-light"
                                                  rows="3"
                                                  placeholder="Ajouter un commentaire..."
                                                  required></textarea>
                                            <div class="d-flex justify-content-end mt-2">
                                                <button type="submit"
                                                        class="btn btn-primary btn-sm px-4">
                                                    Envoyer
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <!-- Sidebar infos -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm sticky-top"
                         style="top:1rem;">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="mb-0 fw-semibold">
                                <i class="bi bi-info-circle me-2 text-primary"></i>
                                Informations
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-5 text-muted small">Statut</dt>
                                <dd class="col-7">
                                    @if (Model.Status == HelpDesk.Models.StatutTicket.Ouvert)
                                    {
                                        <span class="badge-status status-ouvert">Ouvert</span>
                                    }
                                    else if (Model.Status == HelpDesk.Models.StatutTicket.EnCours)
                                    {
                                        <span class="badge-status status-encours">En cours</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status status-resolu">Résolu</span>
                                    }
                                </dd>
                                <dt class="col-5 text-muted small">Priorité</dt>
                                <dd class="col-7">
                                    @if (Model.Priority == HelpDesk.Models.PrioriteTicket.Haute)
                                    {
                                        <span class="badge-priority priority-haute">🔴 Haute</span>
                                    }
                                    else if (Model.Priority == HelpDesk.Models.PrioriteTicket.Moyenne)
                                    {
                                        <span class="badge-priority priority-moyenne">🟠 Moyenne</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary small">🟢 Basse</span>
                                    }
                                </dd>
                                <dt class="col-5 text-muted small">Catégorie</dt>
                                <dd class="col-7">
                                    <span class="badge bg-light text-dark border small">
                                        @Model.Category.ToString()
                                    </span>
                                </dd>
                                <dt class="col-5 text-muted small">Créé par</dt>
                                <dd class="col-7 small">@Model.CreatedByName</dd>
                                <dt class="col-5 text-muted small">Assigné à</dt>
                                <dd class="col-7 small">
                                    @(Model.AssignedToName ?? "Non assigné")
                                </dd>
                                <dt class="col-5 text-muted small">Date</dt>
                                <dd class="col-7 small">
                                    @Model.CreatedAt.ToString("dd/MM/yyyy")
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .sidebar {
        width: 200px;
        min-height: calc(100vh - 60px);
        background: #1F4E79;
        color: white;
        display: flex;
        flex-direction: column;
        padding: 16px 0;
        flex-shrink: 0;
        position: sticky;
        top: 60px;
        height: calc(100vh - 60px);
    }

    .sidebar-section {
        font-size: 0.65rem;
        color: rgba(255,255,255,0.45);
        letter-spacing: 1px;
        padding: 16px 20px 6px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 20px;
        color: rgba(255,255,255,0.75);
        text-decoration: none;
        font-size: 0.88rem;
    }

        .sidebar-link:hover, .sidebar-link.active {
            background: rgba(255,255,255,0.12);
            color: white;
        }

    .sidebar-footer {
        margin-top: auto;
        padding: 16px 20px;
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .user-name {
        font-size: 0.82rem;
        color: white;
    }

    .user-email {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.55);
    }

    .main-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .top-bar {
        background: white;
        border-bottom: 1px solid #e5e7eb;
        padding: 12px 24px;
    }

    .content-area {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }

    .ticket-header {
        background: white;
        border-radius: 10px;
        padding: 24px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .ia-block {
        border-radius: 10px;
        border: 1px solid #BFDBFE;
        overflow: hidden;
    }

    .ia-header {
        background: #EFF6FF;
        padding: 10px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #1D4ED8;
        display: flex;
        justify-content: space-between;
    }

    .ia-body {
        background: white;
        padding: 14px 16px;
    }

    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 600;
    }

    .badge-status {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 500;
    }

    .status-encours {
        background: #FEF3C7;
        color: #92400E;
    }

    .status-ouvert {
        background: #FEE2E2;
        color: #991B1B;
    }

    .status-resolu {
        background: #D1FAE5;
        color: #065F46;
    }

    .badge-priority {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
    }

    .priority-haute {
        background: #FEE2E2;
        color: #991B1B;
    }

    .priority-moyenne {
        background: #FEF3C7;
        color: #92400E;
    }
</style>