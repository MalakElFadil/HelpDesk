@model HelpDesk.ViewModels.CreateTicketViewModel
@{
    ViewData["Title"] = "Nouveau ticket";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- En-tête -->
            <div class="d-flex align-items-center mb-4">
                <a asp-controller="Ticket" asp-action="Index"
                   class="btn btn-outline-secondary btn-sm me-3">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
                <div>
                    <h2 class="mb-0 fw-bold">Nouveau ticket</h2>
                    <small class="text-muted">
                        Décrivez votre problème, l'IA analysera automatiquement votre demande
                    </small>
                </div>
            </div>

            <!-- Info IA -->
            <div class="alert alert-info d-flex align-items-center mb-4">
                <i class="bi bi-robot fs-5 me-2"></i>
                <div>
                    <strong>Analyse IA automatique</strong> — Notre IA (Groq/Llama)
                    analysera votre ticket et suggérera une catégorie, une priorité
                    et une première solution.
                </div>
            </div>

            <!-- Message de succès -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <!-- Formulaire -->
            <div class="card shadow-sm border-0">
                <div class="card-header py-3" style="background-color:#1F4E79;">
                    <h5 class="mb-0 text-white">
                        <i class="bi bi-ticket-detailed me-2"></i>Détails du ticket
                    </h5>
                </div>
                <div class="card-body p-4">

                    @* Erreurs de validation — seulement après soumission *@
                    @if (!ViewData.ModelState.IsValid &&
                                        ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger mb-4">
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Titre -->
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold">
                                Titre <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title"
                                   class="form-control form-control-lg"
                                   placeholder="Résumez votre problème en une phrase..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">
                                Description <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="6"
                                      placeholder="Décrivez votre problème en détail..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                            <div class="form-text">
                                Plus votre description est précise, meilleure sera l'analyse IA.
                            </div>
                        </div>

                        <!-- Catégorie + Priorité -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-semibold">
                                    Catégorie
                                </label>
                                <select asp-for="Category" class="form-select">
                                    <option value="Autre">-- L'IA suggérera --</option>
                                    <option value="Materiel">Matériel</option>
                                    <option value="Logiciel">Logiciel</option>
                                    <option value="Reseau">Réseau</option>
                                    <option value="AccesCompte">Accès / Droits</option>
                                    <option value="Autre">Autre</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label fw-semibold">
                                    Priorité
                                </label>
                                <select asp-for="Priority" class="form-select">
                                    <option value="Basse">🟢 Basse</option>
                                    <option value="Moyenne" selected>🟠 Moyenne</option>
                                    <option value="Haute">🔴 Haute</option>
                                </select>
                            </div>
                        </div>

                        <!-- Boutons -->
                        <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                            <a asp-controller="Ticket" asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="bi bi-send me-2"></i>Soumettre le ticket
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}