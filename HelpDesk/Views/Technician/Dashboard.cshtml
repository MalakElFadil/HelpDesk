@model HelpDesk.ViewModels.TechnicianDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Technicien";
}

<div class="container py-4">

    <!-- En-tête -->
    <div class="mb-4">
        <h2 class="fw-bold mb-0">Dashboard Technicien</h2>
        <small class="text-muted">Vue d'ensemble de vos tickets assignés</small>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                        <i class="bi bi-ticket-detailed fs-4 text-primary"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@Model.TotalAssigned</div>
                        <div class="text-muted small">Total assignés</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                        <i class="bi bi-hourglass-split fs-4 text-warning"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@Model.EnCours</div>
                        <div class="text-muted small">En cours</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3">
                        <i class="bi bi-check-circle fs-4 text-success"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@Model.Resolus</div>
                        <div class="text-muted small">Résolus</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                        <i class="bi bi-exclamation-triangle fs-4 text-danger"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold">@Model.Urgents</div>
                        <div class="text-muted small">Urgents</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Liste tickets récents -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-semibold">
                <i class="bi bi-list-ul me-2 text-primary"></i>
                Tickets à traiter
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Titre</th>
                        <th>Catégorie</th>
                        <th>Priorité</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.TicketsRecents)
                    {
                        <tr>
                            <td class="text-muted small">#@ticket.Id</td>
                            <td class="fw-semibold">@ticket.Title</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @ticket.Category.ToString()
                            </span>
                        </td>
                        <td>
                            @switch (ticket.Priority)
                                {
                                    case HelpDesk.Models.PrioriteTicket.Haute:
                                        <span class="badge bg-danger">🔴 Haute</span>
                                        break;
                                    case HelpDesk.Models.PrioriteTicket.Moyenne:
                                        <span class="badge bg-warning text-dark">🟠 Moyenne</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">🟢 Basse</span>
                                        break;
                                }
                            </td>
                            <td>
                                @switch (ticket.Status)
                                {
                                    case HelpDesk.Models.StatutTicket.Ouvert:
                                        <span class="badge bg-danger">Ouvert</span>
                                        break;
                                    case HelpDesk.Models.StatutTicket.EnCours:
                                        <span class="badge bg-warning text-dark">En cours</span>
                                        break;
                                    case HelpDesk.Models.StatutTicket.Resolu:
                                        <span class="badge bg-success">Résolu</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@ticket.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted small">
                                @ticket.CreatedAt.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@ticket.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Traiter
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>