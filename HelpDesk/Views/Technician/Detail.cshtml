@model HelpDesk.ViewModels.TicketDetailViewModel
@{
    ViewData["Title"] = "Ticket #" + Model.Id;
}

<div class="d-flex" style="min-height: calc(100vh - 60px);">

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-section">NAVIGATION</div>
        <a asp-controller="Technician" asp-action="Dashboard" class="sidebar-link">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Technician" asp-action="Dashboard" class="sidebar-link">
            <i class="bi bi-ticket-detailed"></i> Mes tickets
        </a>
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">TK</div>
                <div>
                    <div class="user-name">Technicien</div>
                    <div class="user-email">tech@@helpdesk.ma</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenu -->
    <div class="main-area">
        <div class="top-bar">
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Technician" asp-action="Assigned"
                   class="text-muted small text-decoration-none">
                    ← Tickets assignés
                </a>
                <span class="text-muted small">/ Ticket #@Model.Id</span>
            </div>
        </div>

        <div class="content-area">

            <!-- Header ticket -->
            <div class="ticket-header mb-4">
                <span class="text-muted small">#@Model.Id</span>
                <h3 class="fw-bold mb-2">@Model.Title</h3>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                    @if (Model.Status == HelpDesk.Models.StatutTicket.EnCours)
                    {
                        <span class="badge-status status-encours">En cours</span>
                    }
                    else if (Model.Status == HelpDesk.Models.StatutTicket.Ouvert)
                    {
                        <span class="badge-status status-ouvert">Ouvert</span>
                    }
                    else
                    {
                        <span class="badge-status status-resolu">Résolu</span>
                    }
                    @if (Model.Priority == HelpDesk.Models.PrioriteTicket.Haute)
                    {
                        <span class="badge-priority priority-haute">Haute priorité</span>
                    }
                    <span class="badge bg-light text-dark border small">
                        <i class="bi bi-tag me-1"></i>@Model.Category.ToString()
                    </span>
                    <span class="text-muted small">
                        👤 @Model.CreatedByName —
                        📅 @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                        — 🔧 Assigné à : Moi
                    </span>
                </div>

                <!-- Changer statut + Marquer résolu -->
                <div class="d-flex align-items-center gap-3">
                    <form asp-action="UpdateStatus" method="post"
                          class="d-flex align-items-center gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <label class="small text-muted mb-0">Changer statut :</label>
                        <select name="statut" class="form-select form-select-sm" style="width:140px;">
    <option value="Ouvert">Ouvert</option>
    <option value="EnCours">En cours</option>
    <option value="Resolu">Résolu</option>
</select>
                        <button type="submit" class="btn btn-sm btn-primary">
                            Appliquer
                        </button>
                    </form>

                    @if (Model.Status != HelpDesk.Models.StatutTicket.Resolu)
                    {
                        <form asp-action="UpdateStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId" value="@Model.Id" />
                            <input type="hidden" name="statut" value="Resolu" />
                            <button type="submit" class="btn btn-sm btn-success">
                                <i class="bi bi-check-circle me-1"></i>Marquer résolu
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- Bloc Analyse IA -->
            @if (!string.IsNullOrEmpty(Model.AIAnalysis))
            {
                <div class="ia-block mb-4">
                    <div class="ia-header">
                        <span>✦ Analyse IA automatique</span>
                        <a href="#" class="small text-muted">Groq / Llama</a>
                    </div>
                    <div class="ia-body">
                        <p class="mb-0 small" style="white-space:pre-wrap;">@Model.AIAnalysis</p>
                    </div>
                </div>
            }

            <!-- Description -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold">Description du problème</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0" style="white-space:pre-wrap;">@Model.Description</p>
                </div>
            </div>

            <!-- Fil de discussion -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex
                            justify-content-between">
                    <h6 class="mb-0 fw-semibold">Fil de discussion</h6>
                    <span class="badge bg-secondary">@Model.Comments.Count messages</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Comments.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">Aucun échange pour l'instant.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var c in Model.Comments)
                            {
                                <li class="list-group-item px-4 py-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle"
                                                 style="background:@(c.IsCurrentUser ? "#1F4E79" : "#6c757d")">
                                                @c.AuthorName.Substring(0, 1).ToUpper()
                                            </div>
                                            <span class="fw-semibold small">
                                                @c.AuthorName
                                            </span>
                                            @if (!string.IsNullOrEmpty(c.AuthorRole))
                                            {
                                                <span class="badge @(c.AuthorRole == "Technicien" ? "bg-info text-dark" : "bg-secondary") small">
                                                    @c.AuthorRole
                                                </span>
                                            }
                                        </div>
                                        <small class="text-muted">
                                            @c.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    <p class="mb-0 ms-5 small">@c.Content</p>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- Zone réponse -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <form asp-action="Reply" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="d-flex gap-3 align-items-start">
                            <div class="avatar-circle" style="background:#1F4E79;flex-shrink:0;">
                                TK
                            </div>
                            <div class="flex-fill">
                                <textarea name="content" class="form-control border-0 bg-light"
                                          rows="3"
                                          placeholder="Écrire une réponse au client..."
                                          required></textarea>
                                <div class="d-flex justify-content-end mt-2">
                                    <button type="submit" class="btn btn-primary btn-sm px-4">
                                        Envoyer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .sidebar { width:200px; min-height:calc(100vh - 60px); background:#1F4E79; color:white; display:flex; flex-direction:column; padding:16px 0; flex-shrink:0; position:sticky; top:60px; height:calc(100vh - 60px); }
    .sidebar-section { font-size:0.65rem; color:rgba(255,255,255,0.45); letter-spacing:1px; padding:16px 20px 6px; }
    .sidebar-link { display:flex; align-items:center; gap:10px; padding:9px 20px; color:rgba(255,255,255,0.75); text-decoration:none; font-size:0.88rem; }
    .sidebar-link:hover, .sidebar-link.active { background:rgba(255,255,255,0.12); color:white; }
    .sidebar-footer { margin-top:auto; padding:16px 20px; border-top:1px solid rgba(255,255,255,0.1); }
    .user-info { display:flex; align-items:center; gap:10px; }
    .user-name {
        font-size: 0.82rem;
        color: white;
    }
    .user-email {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.55);
    }
    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .main-area { flex:1; display:flex; flex-direction:column; overflow:hidden; }
    .top-bar { background:white; border-bottom:1px solid #e5e7eb; padding:12px 24px; }
    .content-area { padding:24px; overflow-y:auto; flex:1; }
    .ticket-header { background:white; border-radius:10px; padding:24px; box-shadow:0 1px 4px rgba(0,0,0,0.06); }
    .badge-status { padding:3px 10px; border-radius:20px; font-size:0.75rem; font-weight:500; }
    .status-encours { background:#FEF3C7; color:#92400E; }
    .status-ouvert  { background:#FEE2E2; color:#991B1B; }
    .status-resolu  { background:#D1FAE5; color:#065F46; }
    .badge-priority { padding:3px 10px; border-radius:20px; font-size:0.72rem; background:#FEE2E2; color:#991B1B; }
    .ia-block { border-radius:10px; border:1px solid #BFDBFE; overflow:hidden; }
    .ia-header { background:#EFF6FF; padding:10px 16px; font-size:0.85rem; font-weight:600; color:#1D4ED8; display:flex; justify-content:space-between; }
    .ia-body { background:white; padding:14px 16px; }
    .avatar-circle { width:32px; height:32px; border-radius:50%; color:white; display:flex; align-items:center; justify-content:center; font-size:0.72rem; font-weight:600; }
</style>