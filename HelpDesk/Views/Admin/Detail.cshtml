@model HelpDesk.ViewModels.AdminTicketDetailViewModel
@{
    ViewData["Title"] = "Ticket #" + Model.Id;
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Admin" asp-action="Tickets">Tous les tickets</a>
            </li>
            <li class="breadcrumb-item active">Ticket #@Model.Id</li>
        </ol>
    </nav>

    <!-- En-tête ticket -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small">#@Model.Id</span>
                    <h3 class="fw-bold mb-2">@Model.Title</h3>
                    <div class="d-flex gap-2 flex-wrap">
                        @switch (Model.Status)
                        {
                            case HelpDesk.Models.StatutTicket.Ouvert:
                                <span class="badge bg-danger">Ouvert</span>
                                break;
                            case HelpDesk.Models.StatutTicket.EnCours:
                                <span class="badge bg-warning text-dark">En cours</span>
                                break;
                            case HelpDesk.Models.StatutTicket.Resolu:
                                <span class="badge bg-success">Résolu</span>
                                break;
                        }
                        @if (Model.Priority == HelpDesk.Models.PrioriteTicket.Haute)
                        {
                            <span class="badge bg-danger">Haute priorité</span>
                        }
                        <span class="badge bg-light text-dark border">
                            @(Model.Category.HasValue
                                                        ? Model.Category.Value.ToString()
                                                        : "Non classé")
                        </span>
                        <span class="text-muted small">
                            👤 @Model.CreatedByName —
                            📅 @Model.CreatedAt.ToString("dd MMM yyyy")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Colonne principale -->
        <div class="col-lg-8">

            <!-- Contrôles Admin : Statut + Assignation -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold">⚙️ Contrôles Administrateur</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        <!-- Changer le statut -->
                        <div class="col-md-6">
                            <form asp-controller="Admin"
                                  asp-action="UpdateStatut" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ticketId"
                                       value="@Model.Id" />
                                <label class="form-label small fw-medium">
                                    Changer le statut
                                </label>
                                <div class="input-group">
                                    <select name="statut" class="form-select">
                                        <option value="Ouvert"
                                                selected="@(Model.Status ==
                                                                                                HelpDesk.Models.StatutTicket.Ouvert)">
                                            Ouvert
                                        </option>
                                        <option value="EnCours"
                                                selected="@(Model.Status ==
                                                                                                HelpDesk.Models.StatutTicket.EnCours)">
                                            En cours
                                        </option>
                                        <option value="Resolu"
                                                selected="@(Model.Status ==
                                                                                                HelpDesk.Models.StatutTicket.Resolu)">
                                            Résolu
                                        </option>
                                    </select>
                                    <button type="submit"
                                            class="btn btn-primary">
                                        Sauvegarder
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Assigner un technicien -->
                        <div class="col-md-6">
                            <form asp-controller="Admin"
                                  asp-action="AssignerTechnicien" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ticketId"
                                       value="@Model.Id" />
                                <label class="form-label small fw-medium">
                                    Assigner à
                                </label>
                                <div class="input-group">
                                    <select name="technicienId" class="form-select">
                                        <option value="">-- Choisir --</option>
                                        @foreach (var tech in Model.Techniciens)
                                        {
                                            <option value="@tech.Id"
                                                    selected="@(tech.Id == Model.AssignedToId)">
                                                @tech.Nom
                                            </option>
                                        }
                                    </select>
                                    <button type="submit"
                                            class="btn btn-success">
                                        Assigner
                                    </button>
                                </div>
                            </form>
                        </div>

                    </div>

                    <!-- Bouton supprimer -->
                    <div class="mt-3 pt-3 border-top">
                        <form asp-controller="Admin"
                              asp-action="DeleteTicket" method="post"
                              onsubmit="return confirm('Supprimer ce ticket ?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId"
                                   value="@Model.Id" />
                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                🗑️ Supprimer ce ticket
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Bloc IA -->
            @if (!string.IsNullOrEmpty(Model.AIAnalysis))
            {
                <div class="card border-0 shadow-sm mb-4"
                     style="border-left: 4px solid #0d6efd !important;">
                    <div class="card-header bg-primary bg-opacity-10 py-3">
                        <h6 class="mb-0 fw-semibold text-primary">
                            🤖 Analyse IA automatique
                        </h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.AIAnalysis</p>
                    </div>
                </div>
            }

            <!-- Description -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold">Description</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0" style="white-space: pre-wrap;">
                        @Model.Description
                    </p>
                </div>
            </div>

            <!-- Fil de discussion (lecture seule pour l'admin) -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold">
                        Fil de discussion
                        <span class="badge bg-secondary ms-2">
                            @Model.Comments.Count
                        </span>
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Comments.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">Aucun commentaire.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var comment in Model.Comments)
                            {
                                <li class="list-group-item px-4 py-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-semibold small">
                                            @comment.AuthorName
                                        </span>
                                        <small class="text-muted">
                                            @comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    <p class="mb-0 small">@comment.Content</p>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

        </div>

        <!-- Colonne latérale -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-semibold">Informations</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted small">Créé par</dt>
                        <dd class="col-7 small">@Model.CreatedByName</dd>

                        <dt class="col-5 text-muted small">Assigné à</dt>
                        <dd class="col-7 small">
                            @(Model.AssignedToName ?? "Non assigné")
                        </dd>

                        <dt class="col-5 text-muted small">Date</dt>
                        <dd class="col-7 small">
                            @Model.CreatedAt.ToString("dd/MM/yyyy")
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

    </div>
</div>