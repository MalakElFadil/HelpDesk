@model HelpDesk.ViewModels.UsersPageViewModel
@{
    ViewData["Title"] = "Gestion des utilisateurs";
}

<div class="container py-4">

    <!-- Mini-stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small">Total comptes</div>
                <div class="fs-3 fw-bold">@Model.Users.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small">Comptes actifs</div>
                <div class="fs-3 fw-bold text-success">
                    @Model.Users.Count(u => u.EstActif)
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-muted small">Techniciens</div>
                <div class="fs-3 fw-bold text-info">
                    @Model.Users.Count(u => u.Role == "Technicien")
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres par rôle -->
    @{
        var currentRole = Context.Request.Query["role"].ToString();
    }
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Users"
           class="btn btn-sm @(string.IsNullOrEmpty(currentRole) ? "btn-primary" : "btn-outline-secondary")">
            Tous
        </a>
        <a asp-action="Users" asp-route-role="Utilisateur"
           class="btn btn-sm @(currentRole == "Utilisateur" ? "btn-secondary text-white" : "btn-outline-secondary")">
            👤 Utilisateurs
        </a>
        <a asp-action="Users" asp-route-role="Technicien"
           class="btn btn-sm @(currentRole == "Technicien" ? "btn-info text-dark" : "btn-outline-info")">
            🔧 Techniciens
        </a>
        <a asp-action="Users" asp-route-role="Administrateur"
           class="btn btn-sm @(currentRole == "Administrateur" ? "btn-danger text-white" : "btn-outline-danger")">
            👑 Admins
        </a>
    </div>

    <!-- Tableau utilisateurs -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nom complet</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Date création</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @user.Prenom @user.Nom
                            </td>
                            <td class="text-muted small">@user.Email</td>
                            <td>
                                @if (user.Role == "Administrateur")
                                {
                                    <span class="badge bg-danger">👑 Admin</span>
                                }
                                else if (user.Role == "Technicien")
                                {
                                    <span class="badge bg-info text-dark">🔧 Technicien</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">👤 Utilisateur</span>
                                }
                            </td>
                            <td>
                                @if (user.EstActif)
                                {
                                    <span class="badge bg-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactif</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @user.DateCreation.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Admin"
                                       asp-action="EditUser"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-controller="Admin"
                                          asp-action="ToggleUser"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id"
                                               value="@user.Id" />
                                        <button type="submit"
                                                class="btn btn-sm @(user.EstActif ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(user.EstActif ? "Désactiver" : "Activer")">
                                            <i class="bi @(user.EstActif ? "bi-person-slash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Modal Ajout compte -->
<div class="modal fade" id="modalAjout" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-person-plus me-2 text-primary"></i>
                    Ajouter un compte
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Prénom <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="prenom"
                                   class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Nom <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="nom"
                                   class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input type="email" name="email"
                                   class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Rôle <span class="text-danger">*</span>
                            </label>
                            <select name="role" class="form-select" required>
                                <option value="Utilisateur">👤 Utilisateur</option>
                                <option value="Technicien">🔧 Technicien</option>
                                <option value="Administrateur">👑 Administrateur</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Mot de passe <span class="text-danger">*</span>
                            </label>
                            <input type="password" name="password"
                                   class="form-control" required
                                   placeholder="Min. 6 caractères" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Annuler
                    </button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-person-plus me-2"></i>Créer le compte
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>