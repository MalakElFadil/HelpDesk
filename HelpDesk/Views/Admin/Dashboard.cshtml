@model HelpDesk.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex" style="min-height: calc(100vh - 60px);">

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-section">PRINCIPAL</div>
        <a asp-controller="Admin" asp-action="Dashboard"
           class="sidebar-link active">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Admin" asp-action="Tickets"
           class="sidebar-link">
            <i class="bi bi-ticket-detailed"></i> Tous les tickets
            <span class="badge bg-danger ms-auto">@Model.TotalTickets</span>
        </a>
        <div class="sidebar-section">GESTION</div>
        <a asp-controller="Admin" asp-action="Users"
           class="sidebar-link">
            <i class="bi bi-people"></i> Utilisateurs
        </a>
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">AD</div>
                <div>
                    <div class="user-name">Admin</div>
                    <div class="user-email">admin@@helpdesk.ma</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenu principal -->
    <div class="main-area">
        <div class="top-bar">
            <span class="page-title">Dashboard</span>
            <div class="d-flex gap-2">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Rechercher un ticket..." />
                </div>
            </div>
        </div>

        <div class="content-area">

            <!-- KPIs -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-label">Total tickets</div>
                    <div class="kpi-value">@Model.TotalTickets</div>
                    <div class="kpi-sub text-muted small">↑ +@(Model.TotalTickets) ce mois</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">En cours</div>
                    <div class="kpi-value text-warning">@Model.TicketsEnCours</div>
                    <div class="kpi-sub text-muted small">À traiter</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Taux résolution</div>
                    <div class="kpi-value text-success">
                        @(Model.TotalTickets > 0
                                                ? $"{(int)((double)Model.TicketsResolus / Model.TotalTickets * 100)}%"
                                                : "0%")
                    </div>
                    <div class="kpi-sub text-muted small">↑ +4% vs mois dernier</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Urgents</div>
                    <div class="kpi-value text-danger">@Model.TicketsUrgents</div>
                    <div class="kpi-sub text-muted small">À traiter</div>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <!-- Tickets récents -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom py-3
                                    d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-semibold">Tickets récents</h6>
                            <a asp-controller="Admin" asp-action="Tickets"
                               class="btn btn-sm btn-outline-primary">
                                Voir tous →
                            </a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="small">#</th>
                                        <th class="small">Titre</th>
                                        <th class="small">Utilisateur</th>
                                        <th class="small">Statut</th>
                                        <th class="small">Priorité</th>
                                        <th class="small">Date</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.TicketsRecents)
                                    {
                                        <tr>
                                            <td class="text-muted small">#@t.Id</td>
                                            <td>
                                                <div class="fw-semibold small">@t.Title</div>
                                                <div class="text-muted" style="font-size:0.75rem;">
                                                    @t.Category.ToString()
                                                </div>
                                            </td>
                                            <td class="small">@t.CreatedByName</td>
                                            <td>
                                                @if (t.Status == HelpDesk.Models.StatutTicket.EnCours)
                                                {
                                                    <span class="badge-status status-encours">En cours</span>
                                                }
                                                else if (t.Status == HelpDesk.Models.StatutTicket.Ouvert)
                                                {
                                                    <span class="badge-status status-ouvert">Ouvert</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-status status-resolu">Résolu</span>
                                                }
                                            </td>
                                            <td>
                                                @if (t.Priority == HelpDesk.Models.PrioriteTicket.Haute)
                                                {
                                                    <span class="badge-priority priority-haute">Haute</span>
                                                }
                                                else if (t.Priority == HelpDesk.Models.PrioriteTicket.Moyenne)
                                                {
                                                    <span class="badge-priority priority-moyenne">Moyenne</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-priority priority-basse">Basse</span>
                                                }
                                            </td>
                                            <td class="text-muted small">
                                                @t.CreatedAt.ToString("dd/MM")
                                            </td>
                                            <td>
                                                <a asp-controller="Admin"
                                                   asp-action="Detail"
                                                   asp-route-id="@t.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Voir
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Colonne droite -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="mb-0 fw-semibold">Tickets / semaine</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-end gap-2"
                                 style="height:80px;">
                                @{
                                    int[] bars = { 3, 5, 4, 7, 6, 8, 5 };
                                    string[] days = { "Lun", "Mar", "Mer", "Jeu", "Ven", "Sam", "Dim" };
                                    int maxBar = bars.Max();
                                }
                                @for (int b = 0; b < bars.Length; b++)
                                {
                                    int h = (int)((double)bars[b] / maxBar * 70);
                                    <div class="text-center flex-fill">
                                        <div style="height:@(h)px;background:#1F4E79;
                                                        border-radius:3px;opacity:@(b == 5 ? 1 : 0.6);">
                                        </div>
                                        <div style="font-size:0.65rem;color:#888;margin-top:3px;">
                                            @days[b]
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="mb-0 fw-semibold">Répartition par catégorie</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-flex flex-column gap-2">
                                @{
                                    var cats = new[] {
                                                                ("Réseau", "#1F4E79", "26%"),
                                                                ("Logiciel", "#2196F3", "27%"),
                                                                ("Matériel", "#64B5F6", "22%"),
                                                                ("Autre", "#BBDEFB", "25%")
                                                                };
                                }
                                @foreach (var (cat, color, pct) in cats)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:10px;height:10px;
                                                        border-radius:50%;background:@color;">
                                        </div>
                                        <span style="font-size:0.8rem;">@cat @pct</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="mb-0 fw-semibold">Performance techniciens</h6>
                        </div>
                        <div class="card-body">
                            @{
                                var techs = new[] {
                                                        ("TK", "Tech. Khalid", 87),
                                                        ("TA", "Tech. Ahmed",  78),
                                                        ("TM", "Tech. Mina",   62)
                                                        };
                            }
                            @foreach (var (initials, name, pct) in techs)
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="user-avatar-sm">@initials</div>
                                    <div class="flex-fill">
                                        <div class="d-flex justify-content-between">
                                            <span style="font-size:0.8rem;">@name</span>
                                            <span style="font-size:0.8rem;font-weight:600;">
                                                @pct%
                                            </span>
                                        </div>
                                        <div class="progress" style="height:4px;margin-top:3px;">
                                            <div class="progress-bar"
                                                 style="width:@pct%;background:#1F4E79;"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .sidebar {
        width: 220px;
        min-height: calc(100vh - 60px);
        background: #1F4E79;
        color: white;
        display: flex;
        flex-direction: column;
        padding: 16px 0;
        flex-shrink: 0;
        position: sticky;
        top: 60px;
        height: calc(100vh - 60px);
    }

    .sidebar-section {
        font-size: 0.65rem;
        color: rgba(255,255,255,0.45);
        letter-spacing: 1px;
        padding: 16px 20px 6px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 20px;
        color: rgba(255,255,255,0.75);
        text-decoration: none;
        font-size: 0.88rem;
        transition: background 0.15s;
    }

        .sidebar-link:hover, .sidebar-link.active {
            background: rgba(255,255,255,0.12);
            color: white;
        }

    .sidebar-footer {
        margin-top: auto;
        padding: 16px 20px;
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-name {
        font-size: 0.82rem;
        color: white;
    }

    .user-email {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.55);
    }

    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .user-avatar-sm {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #1F4E79;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .main-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .top-bar {
        background: white;
        border-bottom: 1px solid #e5e7eb;
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .page-title {
        font-size: 1rem;
        font-weight: 600;
        color: #1a1a2e;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f4f6fa;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 6px 12px;
    }

        .search-box input {
            border: none;
            background: none;
            outline: none;
            font-size: 0.85rem;
            width: 180px;
        }

    .btn-create {
        background: #1F4E79;
        color: white;
        border: none;
        padding: 7px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        text-decoration: none;
        white-space: nowrap;
    }

        .btn-create:hover {
            background: #163a5e;
            color: white;
        }

    .content-area {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 8px;
    }

    .kpi-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .kpi-label {
        font-size: 0.78rem;
        color: #6b7280;
        margin-bottom: 4px;
    }

    .kpi-value {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a2e;
    }

    .kpi-sub {
        margin-top: 2px;
    }

    .badge-status {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .status-encours {
        background: #FEF3C7;
        color: #92400E;
    }

    .status-ouvert {
        background: #FEE2E2;
        color: #991B1B;
    }

    .status-resolu {
        background: #D1FAE5;
        color: #065F46;
    }

    .badge-priority {
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 0.72rem;
    }

    .priority-haute {
        background: #FEE2E2;
        color: #991B1B;
    }

    .priority-moyenne {
        background: #FEF3C7;
        color: #92400E;
    }

    .priority-basse {
        background: #F3F4F6;
        color: #6B7280;
    }
</style>